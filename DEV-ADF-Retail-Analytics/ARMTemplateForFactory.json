{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DEV-ADF-Retail-Analytics"
		},
		"LK_Azure_Sql_Metadata_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LK_Azure_Sql_Metadata'"
		},
		"LK_Ecom_Prac_Tgt_Conn_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LK_Ecom_Prac_Tgt_Conn'"
		},
		"LK_Vendor_Drop_Conn_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LK_Vendor_Drop_Conn'"
		},
		"LK_Azure_Sql_Metadata_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "salesmetadatapip.database.windows.net"
		},
		"LK_Azure_Sql_Metadata_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "vendorsales"
		},
		"LK_Azure_Sql_Metadata_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "CloudSA435f6be5"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pip_child_ingst')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "cpy_file_ingst",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "DelimitedTextSource",
								"storeSettings": {
									"type": "AzureBlobStorageReadSettings",
									"recursive": true,
									"wildcardFolderPath": {
										"value": "@pipeline().parameters.p_src_folder",
										"type": "Expression"
									},
									"wildcardFileName": {
										"value": "@concat(pipeline().parameters.p_src_file,'*.csv')",
										"type": "Expression"
									},
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobStorageWriteSettings"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".txt"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "DS_ADLS_SRC",
								"type": "DatasetReference",
								"parameters": {
									"srcContainer": {
										"value": "@pipeline().parameters.p_src_container",
										"type": "Expression"
									},
									"srcFolderPath": {
										"value": "@pipeline().parameters.p_src_folder",
										"type": "Expression"
									},
									"srcFileName": {
										"value": "@pipeline().parameters.p_src_file",
										"type": "Expression"
									}
								}
							}
						],
						"outputs": [
							{
								"referenceName": "DS_ADLS_SNK",
								"type": "DatasetReference",
								"parameters": {
									"sinkContainer": {
										"value": "@pipeline().parameters.p_sink_container",
										"type": "Expression"
									},
									"sinkfolder": {
										"value": "@pipeline().parameters.p_sink_folder",
										"type": "Expression"
									},
									"sinkFileName": {
										"value": "@concat(pipeline().parameters.p_sink_folder,formatDateTime(utcNow(), 'yyyyMMdd'), '.csv')",
										"type": "Expression"
									}
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_src_container": {
						"type": "string"
					},
					"p_src_folder": {
						"type": "string"
					},
					"p_sink_container": {
						"type": "string"
					},
					"p_sink_folder": {
						"type": "string"
					},
					"p_sink_file": {
						"type": "string"
					},
					"p_src_file": {
						"type": "string"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_SRC')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_SNK')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pip_parent_ingst')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "LKP_Get_File_Config",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "select \n    SourceContainer,\n    SourceFolder,\n    SourceFilename,\n    TargetContainer as sinkContainer,\n    concat(TargetSchema,'/',TargetFolder) as sinkFolder,\n    TargetFileName as sinkFileName\nfrom metadata.AdfPipConfig;",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "DS_AZ_SQL_DB_MT",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "FE_Process_Files",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "LKP_Get_File_Config",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('LKP_Get_File_Config').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"activities": [
								{
									"name": "Exc_Ingest_Files",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "pip_child_ingst",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"P_SourceContainer": {
												"value": "@item.SourceContainer",
												"type": "Expression"
											},
											"P_SourceFolder": {
												"value": "@item.SourceFolder",
												"type": "Expression"
											},
											"P_SourceFileName": {
												"value": "@item.SourceFileName",
												"type": "Expression"
											},
											"P_SinkContainer": {
												"value": "@item.SinkContainer",
												"type": "Expression"
											},
											"P_SinkFolder": {
												"value": "@item.SinkBasePath",
												"type": "Expression"
											},
											"P_SinkFileName": {
												"value": "@item.SinkFileName",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_AZ_SQL_DB_MT')]",
				"[concat(variables('factoryId'), '/pipelines/pip_child_ingst')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pip_test_ecom_prac')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "CopyActivityOrder",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "DelimitedTextSource",
								"storeSettings": {
									"type": "AzureBlobStorageReadSettings",
									"recursive": false,
									"wildcardFolderPath": "order",
									"wildcardFileName": "*.csv",
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobStorageWriteSettings",
									"copyBehavior": "PreserveHierarchy"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".txt"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "vendor_dataset_src",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "ecom_Prac_dataset_tgt",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"folder": {
					"name": "test_pip"
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/vendor_dataset_src')]",
				"[concat(variables('factoryId'), '/datasets/ecom_Prac_dataset_tgt')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_SNK')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LK_Ecom_Prac_Tgt_Conn",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"sinkContainer": {
						"type": "string"
					},
					"sinkfolder": {
						"type": "string"
					},
					"sinkFileName": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"folderPath": {
							"value": "@dataset().sinkfolder",
							"type": "Expression"
						},
						"container": {
							"value": "@dataset().sinkContainer",
							"type": "Expression"
						}
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LK_Ecom_Prac_Tgt_Conn')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_SRC')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LK_Vendor_Drop_Conn",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"srcContainer": {
						"type": "string"
					},
					"srcFolderPath": {
						"type": "string"
					},
					"srcFileName": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": {
							"value": "@dataset().srcFileName",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@dataset().srcFolderPath",
							"type": "Expression"
						},
						"container": {
							"value": "@dataset().srcContainer",
							"type": "Expression"
						}
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LK_Vendor_Drop_Conn')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_AZ_SQL_DB_MT')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LK_Azure_Sql_Metadata",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "ConfigId",
						"type": "int",
						"precision": 10
					},
					{
						"name": "SourceSystem",
						"type": "varchar"
					},
					{
						"name": "SourceFileName",
						"type": "varchar"
					},
					{
						"name": "SourceFolder",
						"type": "varchar"
					},
					{
						"name": "SinkContainer",
						"type": "varchar"
					},
					{
						"name": "SinkBasePath",
						"type": "varchar"
					},
					{
						"name": "FileFormat",
						"type": "varchar"
					},
					{
						"name": "Delimiter",
						"type": "char"
					},
					{
						"name": "HasHeader",
						"type": "bit"
					},
					{
						"name": "LoadType",
						"type": "varchar"
					},
					{
						"name": "WatermarkColumn",
						"type": "varchar"
					},
					{
						"name": "LastWatermark",
						"type": "datetime",
						"precision": 23,
						"scale": 3
					},
					{
						"name": "IsActive",
						"type": "bit"
					},
					{
						"name": "Priority",
						"type": "int",
						"precision": 10
					}
				],
				"typeProperties": {
					"schema": "dbo",
					"table": "ADF_File_Config"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LK_Azure_Sql_Metadata')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ecom_Prac_dataset_tgt')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LK_Ecom_Prac_Tgt_Conn",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"folderPath": {
							"value": "@concat('landing/processed_orders/',formatDateTime(utcNow(),'yyyy/MM/dd'))",
							"type": "Expression"
						},
						"container": "ecom-prac-dev"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LK_Ecom_Prac_Tgt_Conn')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/vendor_dataset_src')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LK_Vendor_Drop_Conn",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"folderPath": "order",
						"container": "vendor-drop-dev"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "order_id,customer_id,product_id,order_amount,order_status,order_date,city",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LK_Vendor_Drop_Conn')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/LK_Azure_Sql_Metadata')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('LK_Azure_Sql_Metadata_properties_typeProperties_server')]",
					"database": "[parameters('LK_Azure_Sql_Metadata_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": true,
					"authenticationType": "SQL",
					"userName": "[parameters('LK_Azure_Sql_Metadata_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('LK_Azure_Sql_Metadata_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LK_Ecom_Prac_Tgt_Conn')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('LK_Ecom_Prac_Tgt_Conn_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LK_Vendor_Drop_Conn')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('LK_Vendor_Drop_Conn_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/IRAZURESQLDB')]",
			"type": "Microsoft.DataFactory/factories/integrationRuntimes",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "Managed",
				"typeProperties": {
					"computeProperties": {
						"location": "AutoResolve",
						"dataFlowProperties": {
							"computeType": "General",
							"coreCount": 8,
							"timeToLive": 10,
							"cleanup": false,
							"customProperties": []
						}
					}
				}
			},
			"dependsOn": []
		}
	]
}