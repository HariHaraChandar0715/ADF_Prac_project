{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DEV-ADF-Retail-Analytics"
		},
		"LK_Azure_Sql_Metadata_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LK_Azure_Sql_Metadata'"
		},
		"LK_Ecom_Prac_Tgt_Conn_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LK_Ecom_Prac_Tgt_Conn'"
		},
		"LK_Vendor_Drop_Conn_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LK_Vendor_Drop_Conn'"
		},
		"LK_Azure_Sql_Metadata_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "salesmetadatapip.database.windows.net"
		},
		"LK_Azure_Sql_Metadata_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "vendorsales"
		},
		"LK_Azure_Sql_Metadata_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "CloudSA435f6be5"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "DEV-ADF-Retail-Analytics_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LK_Azure_Sql_Metadata_password": {
						"value": "[parameters('LK_Azure_Sql_Metadata_password')]"
					},
					"LK_Ecom_Prac_Tgt_Conn_connectionString": {
						"value": "[parameters('LK_Ecom_Prac_Tgt_Conn_connectionString')]"
					},
					"LK_Vendor_Drop_Conn_connectionString": {
						"value": "[parameters('LK_Vendor_Drop_Conn_connectionString')]"
					},
					"LK_Azure_Sql_Metadata_properties_typeProperties_server": {
						"value": "[parameters('LK_Azure_Sql_Metadata_properties_typeProperties_server')]"
					},
					"LK_Azure_Sql_Metadata_properties_typeProperties_database": {
						"value": "[parameters('LK_Azure_Sql_Metadata_properties_typeProperties_database')]"
					},
					"LK_Azure_Sql_Metadata_properties_typeProperties_userName": {
						"value": "[parameters('LK_Azure_Sql_Metadata_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}