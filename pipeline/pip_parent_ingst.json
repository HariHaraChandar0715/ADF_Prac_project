{
	"name": "pip_parent_ingst",
	"properties": {
		"activities": [
			{
				"name": "LKP_Get_File_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select \n    SourceContainer,\n    SourceFolder,\n    SourceFilename,\n    TargetContainer,\n    TargetSchema,\n    TargetFolder,\n    TargetFileName\nfrom metadata.AdfPipConfig;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AZ_SQL_DB_MT",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "FE_Process_Files",
				"type": "ForEach",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "LKP_Get_File_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('LKP_Get_File_Config').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Exc_Ingest_Files",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pip_child_ingst",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"P_SourceContainer": {
										"value": "@item.SourceContainer",
										"type": "Expression"
									},
									"P_SourceFolder": {
										"value": "@item.SourceFolder",
										"type": "Expression"
									},
									"P_SourceFileName": {
										"value": "@item.SourceFileName",
										"type": "Expression"
									},
									"P_SinkContainer": {
										"value": "@item.SinkContainer",
										"type": "Expression"
									},
									"P_SinkFolder": {
										"value": "@item.SinkBasePath",
										"type": "Expression"
									},
									"P_SinkFileName": {
										"value": "@item.SinkFileName",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"annotations": []
	}
}